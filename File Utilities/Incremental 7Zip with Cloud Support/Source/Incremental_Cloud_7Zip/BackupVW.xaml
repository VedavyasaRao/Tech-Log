<Window x:Class="BackupRestoreTool.BackupVW"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupRestoreTool"
        mc:Ignorable="d"
        Title="Backup Tool"  Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <local:SortConverter x:Key="SortConverter" />
        <local:ChkStatusConverter x:Key="ChkStatusConverter" />
    </Window.Resources>
    <DockPanel HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Margin="5,5,5,5" >
        <DockPanel HorizontalAlignment="Stretch"  Height="50" DockPanel.Dock="Top" Margin="0,0,4,0" VerticalAlignment="Top" >
            <Label Content="Units" Margin="10,5,5,0"  DockPanel.Dock="Left" Height="30"/>
            <ComboBox Name="unit" Margin="0,2,5,0"  DockPanel.Dock="Left"  Height="20" SelectionChanged="unit_SelectionChanged">
                <ComboBoxItem IsSelected="True">KB</ComboBoxItem>
                <ComboBoxItem>MB</ComboBoxItem>
                <ComboBoxItem>GB</ComboBoxItem>
            </ComboBox>
            <Label Content="Sort:" Margin="10,5,5,0"  DockPanel.Dock="Left"  Height="30" />
            <ComboBox Name="sort" Margin="0,2,5,0"  DockPanel.Dock="Left"  Height="20" SelectionChanged="sort_SelectionChanged">
                <ComboBoxItem >Title</ComboBoxItem>
                <ComboBoxItem >File Count</ComboBoxItem>
                <ComboBoxItem >Disk Size</ComboBoxItem>
                <ComboBoxItem IsSelected="True">Status</ComboBoxItem>
            </ComboBox>
            <Label Content="Width:" Margin="10,5,5,0"  DockPanel.Dock="Left"  Height="30" />
            <TextBox Name="width" Margin="0,2,5,0" Text="50"  DockPanel.Dock="Left"  HorizontalAlignment="Left" Height="20"  LostFocus="width_LostFocus" />
            <Label Content="Chars" Margin="0,11,5,9"  DockPanel.Dock="Left" HorizontalAlignment="Left" Height="30" />
            <CheckBox x:Name="chkhidearchived" Content="Show Archived items" IsChecked="True" IsThreeState="False" Margin="0,2,5,0"  DockPanel.Dock="Left" HorizontalAlignment="Left"   VerticalAlignment="Bottom" Height="30" Click="chkhidearchived_Click" />
            <Button Content="Backup" Margin="10,10,20,10" Height="30"  Click="Backup_Now_Click" DockPanel.Dock="Right" />
            <Button Content="Refresh" Margin="10,10,5,10" Height="30"  Click="Load_Click" DockPanel.Dock="Right" />
            <StackPanel x:Name="sliderpnl" Visibility="Hidden" Margin="10,5,5,0" Orientation="Vertical" DockPanel.Dock="Right" HorizontalAlignment="Left"  VerticalAlignment="Top" Height="40" >
                <Slider x:Name="slider" Height="20" Width="150" LargeChange="0"  VerticalAlignment="Top" IsSnapToTickEnabled="True" TickFrequency="500" 
                        Focusable="False" Minimum="0" Thumb.DragCompleted="slider_DragCompleted"/>
                <Label Content="{Binding Path=Value, ElementName=slider}" HorizontalAlignment="Center"   VerticalAlignment="Top" Height="30" />
            </StackPanel>
        </DockPanel>
        <TreeView Name="TvDirFiles" 
                      HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" DockPanel.Dock="Top" Margin="5,5,5,5"
                  TreeViewItem.LostFocus="TvDirFiles_LostFocus" TreeViewItem.Expanded="TreeView_OnExpanded" 
                  TreeViewItem.Collapsed ="TreeView_OnCollapsed" TreeViewItem.Selected="TvDirFiles_Selected">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:fileitem}" ItemsSource="{Binding Items, Converter={StaticResource SortConverter}  }">
                    <TextBlock>
                        <CheckBox  Click="CheckBox_Click" IsEnabled="{Binding IsChecked, ElementName=chkhidearchived}" Visibility="{Binding Status,Converter={StaticResource ChkStatusConverter}}"   IsChecked="{Binding Selected,Mode=TwoWay}"/>
                        <TextBlock FontFamily="Courier New"  Foreground="{Binding Foreground}" Text="{Binding Title}" TextAlignment="Left" />
                        <TextBlock FontFamily="Courier New"  Foreground="{Binding Foreground}"  Text="{Binding Status, StringFormat='                {0,20}'}" TextAlignment="Left" />
                        <TextBlock  FontFamily="Courier New" Foreground="{Binding Foreground}"  Text="{Binding Archive, StringFormat='                {0,20}'}"/>
                        <TextBlock  FontFamily="Courier New" Foreground="{Binding Foreground}"  Text="{Binding Size, StringFormat='                {0,20}'}"/>
                        <TextBlock  FontFamily="Courier New" Foreground="{Binding Foreground}"  Text="{Binding Count, StringFormat='                {0,20}'}"/>
                    </TextBlock>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
