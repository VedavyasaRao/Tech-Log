<Window x:Class="BackupRestoreTool.newcollection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupRestoreTool"
        mc:Ignorable="d"
        Title="New Collection"  WindowStyle="ToolWindow" Width="420" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <DockPanel VerticalAlignment="Stretch" Margin="0,0,4,0">
        <StackPanel  DockPanel.Dock="Top" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Label  Content="Name" Margin="10,10,0,0" Width="60"/>
            <TextBox x:Name="txtname" Height="23" Margin="10,10,0,0" Width="280"/>
        </StackPanel>
            <StackPanel   Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="cloudbtn"      Margin="240,10,5,0" DockPanel.Dock="Right" Click="cloudbtn_Click">
                    <Image x:Name="cloudimage" Source="/Images/icecloud.png" Stretch="Uniform"/>
                </Button>
                <Button x:Name="dirbtn"   Margin="10,10,5,0" DockPanel.Dock="Right" Click="Dir_Click">
                    <Image x:Name="harddiskimage" Source="Images/harddisk.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
            <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Label  Content="Location" Margin="10,10,0,0" Width="70"/>
            <TextBox x:Name="location" Height="22" Margin="10,10,0,0" Width="275" IsReadOnly="True"/>
            </StackPanel>
        <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Label  Content="Description" HorizontalAlignment="Left" Margin="10,5,10,0" />
            </StackPanel>
            <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBox x:Name="desc" Margin="10,5,0,5"  TextWrapping="Wrap" Width="346" Height="50"/>
            </StackPanel>

        <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Label  Content="Directories" HorizontalAlignment="Left" Margin="10,5,10,0" />
            <Button x:Name="addbtn" Content="Add"  Margin="10,5,10,5" Height="20" Click="addbtn_Click" />
        </StackPanel>
            <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ListBox x:Name="dirlist" Margin="10,5,0,5" DockPanel.Dock="Top"  Width="346" Height="120" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, 
                    Path=Content}"  
                    IsChecked="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, 
                    Path=IsSelected}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>

            <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" >
            <Label  Margin = "5,5,5,5"  Content="Storage:"  />
            <ComboBox x:Name="bkuploc" Height = "30" Width = "150" Margin = "5,0,5,5"  IsReadOnly="True" SelectionChanged="bkuploc_SelectionChanged" >
                <ComboBoxItem Content = "HardDisk Only"/>
                <ComboBoxItem Content = "Cloud and HardDisk"/>
            </ComboBox>
        </StackPanel>
        <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" >
            <Label  Margin = "5,10,5,5"  Content="Size:"  />
            <ComboBox x:Name="bkupsz" Height = "30" Width = "150" Margin = "5,0,5,5"  IsReadOnly="True">
                <ComboBoxItem Content = "1024"/>
                <ComboBoxItem Content = "512"/>
                <ComboBoxItem Content = "256"/>
            </ComboBox>
            <Label  Margin = "5,10,5,5"  Content="MB"  />
        </StackPanel>
        </StackPanel>
        <StackPanel  DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Left" >
            <Button x:Name="okbtn" Content="Save" HorizontalAlignment="Right"  Margin="350,5,10,5" Width="30" Height="30" Click="okbtn_Click" IsDefault="True"/>
        </StackPanel>
    </DockPanel>
</Window>
