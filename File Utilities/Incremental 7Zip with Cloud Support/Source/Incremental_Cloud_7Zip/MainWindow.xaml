<Window x:Class="BackupRestoreTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BackupRestoreTool"
        mc:Ignorable="d"
        Title="Backup and Restore Tool"  Loaded="Window_Loaded" Closing="Window_Closing" Name="mainwindow">
    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,3.4,0.4" Orientation="Vertical"  >
            <DockPanel HorizontalAlignment="Stretch"  Height="50" Margin="0,0,8,0" VerticalAlignment="Top" >
                <Label Content="Archive Directory" Margin="10,5,5,0" VerticalAlignment="Top"/>
                <Button Content="Disk"  Margin="10,10,10,0" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Dir_Click"/>
                <Button Content="Cloud"  Margin="10,10,10,0"  DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cloud_Click"/>
                <TextBox Name="srcfolder" Text=""  TextWrapping="NoWrap" HorizontalAlignment="Stretch" Margin="0,10,0,0" DockPanel.Dock="Right" VerticalAlignment="Top" />
            </DockPanel>
            <DockPanel HorizontalAlignment="Stretch"  Margin="0,0,8,10" VerticalAlignment="Top" >
                <!--<Button Content="Download Links" Margin="0,0,15,0"   DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Download_Click"/>-->
                <Button Content="Update"   Margin="0,0,15,0"   DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="UpdateVW_Click"/>
                <Button Content="Restore"   Margin="0,0,15,0"   DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top" Click="RestoreVW_Click"/>
                <Button Content="Backup"    Margin="10,0,10,0" DockPanel.Dock="Right" HorizontalAlignment="Right"  VerticalAlignment="Top" Click="BackupVW_Click"/>
                <Button Content="New"    Margin="10,0,5,0" DockPanel.Dock="Left" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="ManageVW_Click"/>
                <Button Content="Edit"    Margin="5,0,10,0" DockPanel.Dock="Left" HorizontalAlignment="Left"  VerticalAlignment="Top" Click="ManageVW_Click"/>
            </DockPanel>
            <DockPanel HorizontalAlignment="Stretch"  Margin="0,0,8,10" VerticalAlignment="Top" />
            <ProgressBar HorizontalAlignment="Stretch"  Height="20" Name="progress"/>
        </StackPanel>
        <ScrollViewer Name="vsb">
            <TextBlock  TextWrapping="Wrap"  Name="log" />
        </ScrollViewer>
    </DockPanel>
</Window>
